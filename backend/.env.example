# ShopKart Backend Environment Configuration Template
# Copy this file to .env and provide your actual credentials

PORT=5001
MONGO_URI=mongodb://localhost:27017/shopkart
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test Mode Credentials
# Generate these from: Razorpay Dashboard -> Settings -> API Keys (Enable Test Mode)
# NOTE: RAZORPAY_KEY_SECRET must NEVER be shared with frontend or committed to git.
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
